# ===== 蓝队业务管理系统 · 生产环境变量 =====
# 建议直接使用部署脚本（首次部署会自动复制并生成全部随机口令/密钥 + 自签证书）：
#   bash deploy/deploy.sh up
# 也可手动：cp deploy/.env.prod.example deploy/.env.prod 并修改敏感值。

# ---- 数据库 / 存储口令（deploy.sh 首次部署自动替换为随机值；手动部署务必修改）----
POSTGRES_PASSWORD=blueteam_pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- 安全（deploy.sh 首次部署自动替换为随机串；后端检测到占位符会拒绝启动）----
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret

# ---- AI：DeepSeek 主通道；留空则直接走 Ollama ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=llama3

# ---- 告警外部通知：留空即关闭该渠道 ----
# 企业微信机器人 webhook（群内推送）；type：wecom / dingtalk / feishu（飞书）/ generic（通用 JSON POST）
# 飞书示例：ALERT_NOTIFY_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的机器人token
ALERT_NOTIFY_WEBHOOK_URL=
ALERT_NOTIFY_WEBHOOK_TYPE=wecom
# SMTP 邮件通知（需自备邮箱服务；465 SSL）
ALERT_NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 扫描风险评分达到该值（0-100）自动产生告警并通知
ALERT_RISK_THRESHOLD=70

# ---- 租约回收：定时任务间隔（分钟）----
LEASE_RECYCLE_INTERVAL_MINUTES=60

# ---- 文件上传白名单（扩展名逗号分隔；后端同时校验 MIME 与大小）----
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,bmp,ico,pdf,doc,docx,xls,xlsx,ppt,pptx,csv,txt,md,log,zip,rar,7z,tar,gz

# ---- 对外访问域名（决定 CORS 允许来源；仅 80 端口单机时留 http://localhost）----
FRONTEND_ORIGIN=http://localhost
