# 复制为 .env 使用
DATABASE_URL=postgresql+asyncpg://blueteam:blueteam_pass@localhost:5432/blueteam
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# ---- 漏洞扫描（nmap）可选覆盖 ----
# NMAP_TOP_PORTS=1000               # 未指定端口数/范围时的默认 --top-ports（1000 与 nmapGUI top-1000 覆盖一致）
# NMAP_NSE_SCRIPTS=vuln             # ""=全局关闭 NSE；"vuln"=离线漏洞签名；"vulners"=需外网
# NMAP_UDP_TOP_PORTS=20             # UDP(sU) 默认端口数
# NMAP_UDP_TIMEOUT_SECONDS=300      # UDP 扫描专属超时（秒）
# NMAP_MAX_PORTS_IN_RANGE=1024      # port_range 展开端口数上限，防全端口 DoS
